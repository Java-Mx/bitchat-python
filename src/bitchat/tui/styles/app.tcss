/* ==============================================================================
   BitChat Professional Terminal Design System (app.tcss)
   Strict 5-Family Palette: Black, Blue, Purple, Deterministic Identity, Semantic Status
   Phase 9.2: TUI UX Polish, Subtle Dark Borders & Uniform Alignment
   ============================================================================== */

Screen {
    background: #080a0f;
    color: #e6edf3;
    layout: vertical;
    margin: 0;
    padding: 0;
}

/* ------------------------------------------------------------------------------
   Top Application Header (Compact 1-row, edge-to-edge)
   ------------------------------------------------------------------------------ */
HeaderWidget {
    dock: top;
    height: 1;
    background: #0a0d14;
    border-bottom: solid #1b2030;
    padding: 0 1;
    layout: horizontal;
    align: left middle;
}

#header-brand {
    text-style: bold;
    color: #58a6ff;
    width: auto;
}

#header-version {
    color: #57606a;
    width: auto;
    margin-left: 1;
}

#header-channel {
    color: #bc8cff;
    width: auto;
    margin-left: 2;
}

#header-status {
    width: auto;
    margin-left: 2;
    color: #3fb950;
}

#header-right {
    dock: right;
    width: auto;
    color: #8b949e;
}

/* ------------------------------------------------------------------------------
   Main Viewport Layout (Horizontal Split: Sidebar + Chat)
   ------------------------------------------------------------------------------ */
#main-body {
    height: 1fr;
    layout: horizontal;
    background: #080a0f;
    margin: 0;
    padding: 0;
}

/* ------------------------------------------------------------------------------
   Left Navigation / Peer Sidebar
   ------------------------------------------------------------------------------ */
PeerSidebar {
    width: 30;
    min-width: 22;
    max-width: 36;
    height: 100%;
    background: #080a0f;
    border: round #22283a;
    border-title-align: left;
    border-title-style: bold;
    border-title-color: #58a6ff;
    padding: 0;
    layout: vertical;
}

#identity-card {
    height: auto;
    background: #0f121c;
    border-bottom: solid #1b2030;
    padding: 0 1;
    margin: 0;
}

#identity-title {
    text-style: bold;
    color: #58a6ff;
    height: 1;
}

#identity-box {
    height: auto;
    color: #e6edf3;
    padding-bottom: 0;
}

.sidebar-section-title {
    text-style: bold;
    color: #8b949e;
    padding: 0 1;
    margin-top: 1;
    height: 1;
}

.peer-list-view {
    height: auto;
    max-height: 1fr;
    background: #080a0f;
    border: none;
    padding: 0;
}

.peer-list-view > ListItem {
    background: #080a0f;
    padding: 0 1;
    height: auto;
}

.peer-list-view > ListItem:hover {
    background: #141824;
}

.peer-list-view > ListItem.--highlight {
    background: #1e2438;
}

/* ------------------------------------------------------------------------------
   Main Content Area (Chat View & Input Column)
   ------------------------------------------------------------------------------ */
#chat-column {
    width: 1fr;
    height: 100%;
    layout: vertical;
    background: #080a0f;
    margin: 0;
    padding: 0;
}

ChatView {
    height: 1fr;
    background: #080a0f;
    border: round #22283a;
    border-title-align: left;
    border-title-style: bold;
    border-title-color: #58a6ff;
    layout: vertical;
    padding: 0 1;
}

#chat-log {
    height: 1fr;
    background: #080a0f;
    color: #e6edf3;
    border: none;
    padding: 0;
    scrollbar-size-vertical: 1;
    scrollbar-color: #22283a;
    scrollbar-color-hover: #388bfd;
    scrollbar-color-active: #58a6ff;
}

/* ------------------------------------------------------------------------------
   Input Area & Command Palette (Subtle Dark Borders)
   ------------------------------------------------------------------------------ */
#input-container {
    height: auto;
    layout: vertical;
    background: #080a0f;
    margin: 0;
    padding: 0;
}

AutocompletePalette {
    height: auto;
    max-height: 8;
    background: #0f121c;
    border: round #28334e;
    border-title-align: left;
    border-title-style: bold;
    border-title-color: #58a6ff;
    padding: 0;
    display: none;
    margin-bottom: 0;
}

#autocomplete-option-list {
    height: auto;
    max-height: 8;
    background: #0f121c;
    border: none;
    scrollbar-size-vertical: 1;
    scrollbar-color: #22283a;
}

#autocomplete-option-list > .option-list--option-highlighted {
    background: #1e2438;
    color: #58a6ff;
}

MessageInput {
    height: 3;
    background: #0f121c;
    border: round #22283a;
    color: #e6edf3;
    padding: 0 1;
    margin: 0;
}

MessageInput:focus {
    border: round #28334e;
    background: #121624;
}

/* ------------------------------------------------------------------------------
   Interactive Action Bar & Telemetry Footer
   ------------------------------------------------------------------------------ */
StatusBar {
    dock: bottom;
    height: 3;
    background: #0a0d14;
    border-top: solid #1b2030;
    color: #8b949e;
    padding: 0 1;
    layout: vertical;
}

#status-action-row {
    height: 1;
    layout: horizontal;
    align: left middle;
}

.action-btn {
    height: 1;
    min-width: 8;
    background: #141824;
    color: #8b949e;
    border: none;
    padding: 0 1;
    margin-right: 1;
}

.action-btn:hover {
    background: #1e2438;
    color: #58a6ff;
}

#status-telemetry-row {
    height: 1;
    layout: horizontal;
    align: left middle;
    color: #57606a;
}

#status-left {
    width: 1fr;
    color: #8b949e;
}

#status-center {
    width: auto;
    color: #bc8cff;
    margin-right: 2;
}

#status-right {
    width: auto;
    color: #57606a;
}

/* ------------------------------------------------------------------------------
   Modal Screens (Help, Peer Info, Settings, Edit Theme, BLE Error)
   ------------------------------------------------------------------------------ */
HelpScreen, PeerInfoModal, SettingsModal, EditThemeModal, BLEErrorModal {
    align: center middle;
    background: rgba(8, 10, 15, 0.85);
}

#help-dialog, #peer-info-dialog, #settings-dialog, #edit-theme-dialog {
    width: 76;
    max-width: 95%;
    height: auto;
    max-height: 85%;
    background: #0f121c;
    border: round #28334e;
    border-title-align: left;
    border-title-style: bold;
    border-title-color: #58a6ff;
    padding: 1 2;
}

#help-title, #peer-info-title, #settings-title, #edit-theme-title {
    text-style: bold;
    color: #58a6ff;
    margin-bottom: 1;
}

#help-table {
    height: auto;
    max-height: 18;
    background: #080a0f;
    border: round #22283a;
    margin-bottom: 1;
}

#help-close-btn {
    dock: right;
    background: #161b26;
    color: #e6edf3;
    border: round #22283a;
}

#help-close-btn:hover {
    background: #1e2438;
    border: round #28334e;
}

/* Peer Info Modal Styling */
#peer-info-card {
    height: auto;
    background: #080a0f;
    border: round #22283a;
    padding: 1;
    margin-bottom: 1;
}

.peer-info-section {
    height: auto;
    margin-bottom: 1;
}

#peer-info-actions {
    height: 1;
    layout: horizontal;
    align: right middle;
}

/* Settings & Theme Forms */
#settings-form, #edit-theme-form {
    height: auto;
    background: #080a0f;
    border: round #22283a;
    padding: 1;
    margin-bottom: 1;
}

.settings-field-label {
    text-style: bold;
    color: #8b949e;
    margin-top: 1;
}

#settings-input-nickname, #settings-input-hops, #settings-input-delay {
    height: 3;
    background: #0f121c;
    border: round #22283a;
    color: #e6edf3;
    margin-bottom: 1;
}

#settings-input-nickname:focus, #settings-input-hops:focus, #settings-input-delay:focus {
    border: round #28334e;
    background: #121624;
}

#settings-hint, #edit-theme-hint {
    height: auto;
    margin-top: 1;
}

#settings-actions, #edit-theme-actions {
    height: 1;
    layout: horizontal;
    align: right middle;
}

/* BLE Error Modal */
#ble-error-dialog {
    width: 70;
    max-width: 95%;
    height: auto;
    max-height: 85%;
    background: #140d0d;
    border: round #4a2222;
    border-title-align: left;
    border-title-style: bold;
    border-title-color: #f85149;
    padding: 1 2;
}

#ble-error-title {
    text-style: bold;
    color: #f85149;
    margin-bottom: 1;
}

#ble-error-content {
    height: auto;
    background: #0a0606;
    border: round #3d1a1a;
    padding: 1;
    margin-bottom: 1;
}

.ble-error-text {
    height: auto;
}

#ble-error-actions {
    height: 1;
    layout: horizontal;
    align: right middle;
}

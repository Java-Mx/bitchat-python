/* ==============================================================================
   BitChat Professional Terminal Design System (app.tcss)
   Strict 5-Family Palette: Black, Blue, Purple, Deterministic Identity, Semantic Status
   Phase 9.2: TUI UX Polish, Subtle Dark Borders & Uniform Alignment
   ============================================================================== */

Screen {
    background: #080a0f;
    color: #e6edf3;
    layout: vertical;
    margin: 0;
    padding: 0;
}

/* ------------------------------------------------------------------------------
   Top Application Header (Compact 1-row, edge-to-edge)
   ------------------------------------------------------------------------------ */
HeaderWidget {
    dock: top;
    height: 1;
    background: #0a0d14;
    border-bottom: solid #1b2030;
    padding: 0 1;
    layout: horizontal;
    align: left middle;
}

#header-brand {
    text-style: bold;
    color: #58a6ff;
    width: auto;
}

#header-version {
    color: #57606a;
    width: auto;
    margin-left: 1;
}

#header-channel {
    color: #bc8cff;
    width: auto;
    margin-left: 2;
}

#header-status {
    width: auto;
    margin-left: 2;
    color: #3fb950;
}

#header-right {
    dock: right;
    width: auto;
    color: #8b949e;
}

/* ------------------------------------------------------------------------------
   Main Viewport Layout (Horizontal Split: Sidebar + Chat)
   ------------------------------------------------------------------------------ */
#main-body {
    height: 1fr;
    layout: horizontal;
    background: #080a0f;
    margin: 0;
    padding: 0;
}

/* ------------------------------------------------------------------------------
   Left Navigation / Peer Sidebar
   ------------------------------------------------------------------------------ */
PeerSidebar {
    width: 30;
    min-width: 22;
    max-width: 36;
    height: 100%;
    background: #080a0f;
    border: round #22283a;
    border-title-align: left;
    border-title-style: bold;
    border-title-color: #58a6ff;
    padding: 0;
    layout: vertical;
}

#identity-card {
    height: auto;
    background: #0f121c;
    border-bottom: solid #1b2030;
    padding: 0 1;
    margin: 0;
}

#identity-title {
    text-style: bold;
    color: #58a6ff;
    height: 1;
}

#identity-box {
    height: auto;
    color: #e6edf3;
    padding-bottom: 0;
}

.sidebar-section-title {
    text-style: bold;
    color: #8b949e;
    padding: 0 1;
    margin-top: 1;
    height: 1;
}

.peer-list-view {
    height: auto;
    max-height: 1fr;
    background: #080a0f;
    border: none;
    padding: 0;
}

.peer-list-view > ListItem {
    background: #080a0f;
    padding: 0 1;
    height: auto;
}

.peer-list-view > ListItem:hover {
    background: #141824;
}

.peer-list-view > ListItem.--highlight {
    background: #1e2438;
}

/* ------------------------------------------------------------------------------
   Main Content Area (Chat View & Input Column)
   ------------------------------------------------------------------------------ */
#chat-column {
    width: 1fr;
    height: 100%;
    layout: vertical;
    background: #080a0f;
    margin: 0;
    padding: 0;
}

ChatView {
    height: 1fr;
    background: #080a0f;
    border: round #22283a;
    border-title-align: left;
    border-title-style: bold;
    border-title-color: #58a6ff;
    layout: vertical;
    padding: 0 1;
}

#chat-log {
    height: 1fr;
    background: #080a0f;
    color: #e6edf3;
    border: none;
    padding: 0;
    scrollbar-size-vertical: 1;
    scrollbar-color: #22283a;
    scrollbar-color-hover: #388bfd;
    scrollbar-color-active: #58a6ff;
}

/* ------------------------------------------------------------------------------
   Input Area & Command Palette (Subtle Dark Borders)
   ------------------------------------------------------------------------------ */
#input-container {
    height: auto;
    layout: vertical;
    background: #080a0f;
    margin: 0;
    padding: 0;
}

AutocompletePalette {
    height: auto;
    max-height: 8;
    background: #0f121c;
    border: round #28334e;
    border-title-align: left;
    border-title-style: bold;
    border-title-color: #58a6ff;
    padding: 0;
    display: none;
    margin-bottom: 0;
}

#autocomplete-option-list {
    height: auto;
    max-height: 8;
    background: #0f121c;
    border: none;
    scrollbar-size-vertical: 1;
    scrollbar-color: #22283a;
}

#autocomplete-option-list > .option-list--option-highlighted {
    background: #1e2438;
    color: #58a6ff;
}

MessageInput {
    height: 3;
    background: #0f121c;
    border: round #22283a;
    color: #e6edf3;
    padding: 0 1;
    margin: 0;
}

MessageInput:focus {
    border: round #28334e;
    background: #121624;
}

/* ------------------------------------------------------------------------------
   Interactive Action Bar & Telemetry Footer
   ------------------------------------------------------------------------------ */
StatusBar {
    dock: bottom;
    height: 4;
    background: #0a0d14;
    border-top: solid #1b2030;
    color: #8b949e;
    padding: 0 1;
    layout: vertical;
}

#status-container {
    height: 100%;
    width: 100%;
    layout: horizontal;
    align: left middle;
}

#status-telemetry-col {
    width: 1fr;
    height: 100%;
    layout: vertical;
    align-vertical: middle;
}

#status-line-mesh {
    height: 1;
    color: #3fb950;
    text-style: bold;
}

#status-line-crypto {
    height: 1;
    color: #8b949e;
}

#status-line-target {
    height: 1;
    color: #58a6ff;
}

#status-actions-grid {
    layout: grid;
    grid-size: 3 2;
    grid-columns: 1fr 1fr 1fr;
    grid-rows: 1 1;
    width: 48;
    min-width: 33;
    max-width: 54;
    height: 3;
    align-vertical: middle;
}

.action-btn {
    height: 1;
    width: 100%;
    background: #141824;
    color: #8b949e;
    border: none;
    padding: 0 1;
    text-align: center;
}

.action-btn:hover {
    background: #1e2438;
    color: #58a6ff;
}

.action-btn:focus {
    background: #1f6feb;
    color: #ffffff;
}

/* ------------------------------------------------------------------------------
   Modal Screens (Help, Peer Info, Settings, Edit Theme, BLE Error)
   ------------------------------------------------------------------------------ */
HelpScreen, PeerInfoModal, SettingsModal, EditThemeModal, BLEErrorModal {
    align: center middle;
    background: rgba(8, 10, 15, 0.85);
}

#help-dialog {
    width: 90%;
    max-width: 120;
    height: 85%;
    max-height: 40;
    background: #0f121c;
    border: round #28334e;
    border-title-align: left;
    border-title-style: bold;
    border-title-color: #58a6ff;
    padding: 1 2;
    layout: vertical;
}

#peer-info-dialog, #settings-dialog, #edit-theme-dialog {
    width: 76;
    max-width: 95%;
    height: auto;
    max-height: 85%;
    background: #0f121c;
    border: round #28334e;
    border-title-align: left;
    border-title-style: bold;
    border-title-color: #58a6ff;
    padding: 1 2;
}

#help-title, #peer-info-title, #settings-title, #edit-theme-title {
    text-style: bold;
    color: #58a6ff;
    margin-bottom: 1;
}

#help-table {
    width: 100%;
    height: 1fr;
    background: #080a0f;
    border: round #22283a;
    margin-bottom: 0;
}

#help-actions {
    height: 3;
    width: 100%;
    align: center middle;
    margin-top: 1;
    border-top: solid #1b2030;
}

#help-close-btn {
    min-width: 16;
    height: 1;
    background: #161b26;
    color: #e6edf3;
    border: round #22283a;
    text-align: center;
}

#help-close-btn:hover {
    background: #1e2438;
    border: round #28334e;
    color: #58a6ff;
}

/* Peer Info Modal Styling */
#peer-info-card {
    height: auto;
    background: #080a0f;
    border: round #22283a;
    padding: 1;
    margin-bottom: 1;
}

.peer-info-section {
    height: auto;
    margin-bottom: 1;
}

#peer-info-actions {
    height: 1;
    layout: horizontal;
    align: right middle;
}

/* Settings & Theme Forms */
#settings-form, #edit-theme-form {
    height: auto;
    background: #080a0f;
    border: round #22283a;
    padding: 1;
    margin-bottom: 1;
}

.settings-field-label {
    text-style: bold;
    color: #8b949e;
    margin-top: 1;
}

#settings-input-nickname, #settings-input-hops, #settings-input-delay {
    height: 3;
    background: #0f121c;
    border: round #22283a;
    color: #e6edf3;
    margin-bottom: 1;
}

#settings-input-nickname:focus, #settings-input-hops:focus, #settings-input-delay:focus {
    border: round #28334e;
    background: #121624;
}

#settings-hint, #edit-theme-hint {
    height: auto;
    margin-top: 1;
}

#settings-actions, #edit-theme-actions {
    height: 1;
    layout: horizontal;
    align: right middle;
}

#settings-actions .action-btn, #edit-theme-actions .action-btn, #peer-info-actions .action-btn, #ble-error-actions .action-btn {
    width: auto;
    min-width: 14;
    margin-left: 1;
}

/* BLE Error Modal */
#ble-error-dialog {
    width: 70;
    max-width: 95%;
    height: auto;
    max-height: 85%;
    background: #140d0d;
    border: round #4a2222;
    border-title-align: left;
    border-title-style: bold;
    border-title-color: #f85149;
    padding: 1 2;
}

#ble-error-title {
    text-style: bold;
    color: #f85149;
    margin-bottom: 1;
}

#ble-error-content {
    height: auto;
    background: #0a0606;
    border: round #3d1a1a;
    padding: 1;
    margin-bottom: 1;
}

.ble-error-text {
    height: auto;
}

#ble-error-actions {
    height: 1;
    layout: horizontal;
    align: right middle;
}

/* ------------------------------------------------------------------------------
   Display Density Modes (Comfortable vs Compact)
   ------------------------------------------------------------------------------ */
.density-comfortable PeerSidebar {
    width: 30;
    padding: 0;
}

.density-compact PeerSidebar {
    width: 25;
    padding: 0;
}

.density-compact #identity-card {
    padding: 0;
}

.density-compact .sidebar-section-title {
    padding: 0;
    margin: 0;
}

.density-compact .peer-list-item {
    padding: 0;
    margin: 0;
}

.density-compact MessageInput {
    height: 3;
    padding: 0 1;
}

/* ------------------------------------------------------------------------------
   Accent Themes (Strict 5-Family Palette Integration)
   ------------------------------------------------------------------------------ */
.accent-blue #header-brand {
    color: #58a6ff;
}
.accent-blue #identity-title {
    color: #58a6ff;
}
.accent-blue PeerSidebar {
    border-title-color: #58a6ff;
}
.accent-blue ChatView {
    border-title-color: #58a6ff;
}
.accent-blue MessageInput:focus {
    border: round #388bfd;
    background: #121624;
}
.accent-blue .action-btn:focus {
    border: solid #58a6ff;
    color: #58a6ff;
}
.accent-blue #autocomplete-option-list > .option-list--option-highlighted {
    background: #1e2438;
    color: #58a6ff;
}

.accent-cyan #header-brand {
    color: #39c5cf;
}
.accent-cyan #identity-title {
    color: #39c5cf;
}
.accent-cyan PeerSidebar {
    border-title-color: #39c5cf;
}
.accent-cyan ChatView {
    border-title-color: #39c5cf;
}
.accent-cyan MessageInput:focus {
    border: round #39c5cf;
    background: #0f1820;
}
.accent-cyan .action-btn:focus {
    border: solid #39c5cf;
    color: #39c5cf;
}
.accent-cyan #autocomplete-option-list > .option-list--option-highlighted {
    background: #10262e;
    color: #39c5cf;
}

.accent-emerald #header-brand {
    color: #56d364;
}
.accent-emerald #identity-title {
    color: #56d364;
}
.accent-emerald PeerSidebar {
    border-title-color: #56d364;
}
.accent-emerald ChatView {
    border-title-color: #56d364;
}
.accent-emerald MessageInput:focus {
    border: round #56d364;
    background: #101c13;
}
.accent-emerald .action-btn:focus {
    border: solid #56d364;
    color: #56d364;
}
.accent-emerald #autocomplete-option-list > .option-list--option-highlighted {
    background: #13261a;
    color: #56d364;
}

.accent-purple #header-brand {
    color: #bc8cff;
}
.accent-purple #identity-title {
    color: #bc8cff;
}
.accent-purple PeerSidebar {
    border-title-color: #bc8cff;
}
.accent-purple ChatView {
    border-title-color: #bc8cff;
}
.accent-purple MessageInput:focus {
    border: round #bc8cff;
    background: #181224;
}
.accent-purple .action-btn:focus {
    border: solid #bc8cff;
    color: #bc8cff;
}
.accent-purple #autocomplete-option-list > .option-list--option-highlighted {
    background: #271b3d;
    color: #bc8cff;
}


#!/bin/sh
set -e

if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    # Clean up any leftover runtime directories or launchers under /usr/lib/bitchat
    rm -rf /usr/lib/bitchat 2>/dev/null || true
    rm -f /usr/bin/bitchat 2>/dev/null || true
    rm -f /usr/share/applications/bitchat.desktop 2>/dev/null || true

    if [ -x /usr/bin/update-desktop-database ]; then
        update-desktop-database -q /usr/share/applications 2>/dev/null || true
    fi
fi

if [ "$1" = "purge" ]; then
    rm -rf /var/cache/bitchat 2>/dev/null || true
    if [ -n "${SUDO_USER:-}" ] && [ "${SUDO_USER}" != "root" ]; then
        USER_HOME=$(getent passwd "${SUDO_USER}" 2>/dev/null | cut -d: -f6 || true)
        if [ -n "${USER_HOME}" ] && [ -d "${USER_HOME}" ]; then
            rm -rf "${USER_HOME}/.cache/bitchat" 2>/dev/null || true
        fi
    fi
fi

exit 0
